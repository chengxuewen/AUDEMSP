# MediaServo Caddy reverse proxy configuration
# Dev: .local domain — Caddy auto-generates self-signed cert
# Prod: replace with real domain for Let's Encrypt TLS
mediaservo.local, localhost {

	# Reverse proxy WebSocket signaling to server
	# Caddy 2 automatically handles WebSocket upgrades (no special config needed)
	reverse_proxy server:9800

	# Security headers
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}