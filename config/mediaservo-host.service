[Unit]
Description=MediaServo Host Service
After=network.target
Wants=network.target

[Service]
Type=notify
ExecStart=/opt/mediaservo/bin/mediaservo-host --config /opt/mediaservo/etc/host.conf
Restart=always
RestartSec=5
WatchdogSec=30
StandardOutput=journal
StandardError=journal
Environment=RUST_LOG=info
Environment=GST_PLUGIN_PATH=/opt/mediaservo/lib/gstreamer-1.0

[Install]
WantedBy=multi-user.target
